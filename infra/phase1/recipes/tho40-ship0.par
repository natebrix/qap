0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
4    number of branching rules

0.20 use this rule when gap is worse than...
2    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
4    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 12   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 3    compute B for best _ rows of U

0.0 use this rule when gap is worse than... (all nodes thru depth 6 use rule 8)
6    use this rule thru this depth.
 9    branching rule at top of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 2    branching rule at bottom of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

[settings]
# infra/phase1/recipes/tho40-ship0.par: experiments/estimates/tho40/tho40.par with
# ship.bits = 0: no parent DNN state in state files; a node handed to another unit starts its DNN cold.
# tho40's current settings (experiments/estimates/README.md): the Nov 8 nug30 record
# recipe (infra/phase1/recipes/nug30.par: rule 9, DNN at depths 1-7, give-up 200, no cut
# phase, ship.bits = 64) with branch.xbar_lines = 2, the setting the tho40 A/B of Nov 9
# carries into any long run (experiments/xbar_lines_sweep/tho40_ab/: 723 to 581 nodes on
# three depth-3 subtrees). Identical to that A/B's logs/x2.par.
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.cheb = 3
dnn.tight_lam = 2
dnn.beta = 0.21
dnn.refresh = 120
dnn.warm_y = 2
dnn.ext = 20
dnn.gu_zone = 0.003
ship.bits = 0
dnn.cross = 2
dnn.lazycert = 1
dnn.beta_sched = w=0.36
dnn.depths = 1:7
dnn.maxgap = 1
dnn.giveup = 200
dnn.warm = 1
branch.xbar_lines = 2
