0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
5    number of branching rules

0.20 use this rule when gap is worse than...
1    use this rule thru this depth. (2 until Nov 24: a depth-2 node above 0.20 now falls to the next block, rule 10)
 9    branching rule at top of tree (the root and depth 1 on sko42)
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
2    use this rule thru this depth. (4 until Nov 23; sko42-261120b used this block at depth 2 only)
 10   branching rule: every line, the size score on the children's QPB bounds (depth 2; rule 9 until Nov 23)
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection (12 until Nov 23; 25 is what ucheap/sko42sub measured)
 1    which bound?
 30   step for parametric bound
 99   compute B for best _ rows of U (rule 10: 99 = every row and column)

0.0 use this rule when gap is worse than... (the rest of depth 2: a block added Nov 23)
2    use this rule thru this depth.
 10   branching rule: every line, the size score on the children's QPB bounds (depth 2)
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 99   compute B for best _ rows of U (rule 10: 99 = every row and column)

0.0 use this rule when gap is worse than... (depths 3 to 6, unchanged)
6    use this rule thru this depth.
 9    branching rule at top of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 9    branching rule at bottom of tree (rule 9 for 2: rule9_bottom)
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

[settings]
# sko42's current settings (experiments/estimates/README.md), from Nov 12: tuning arm C,
# experiments/estimates/sko42/tune/C.par. That is wil50's full run
# (experiments/wil50_feasibility/fullrun/fullrun.par: CP cut phase, rule 9, DNN at depths
# 1-4 then 20 levels below a miss until Nov 14, every depth since, give-up 300) with the grid 6 x 7 and cut.zone = 0.010
# (158 short on sko42). On sko42t.dat the grid is the second matrix (checked:
# rectilinear, row-major, 7 columns), so cut.side = 1 as on wil50t.
# On matched complete subtrees (tune/README.md), arm B (C with wil50's zone 0.0075) took
# 1.15-2.8x less CPU than arm A, this file's settings until Nov 12 (the nug30 record
# recipe: rule 9, DNN at depths 1-7, give-up 200, no cut phase); C took 21-39% less than B.
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.ext = 20
dnn.amx = 1
dnn.cheb = 3
dnn.tight_lam = 2
dnn.refresh = 40
dnn.warm_y = 2
pool.on = 1
dnn.beta = 0.3
dnn.gu_zone = 0
cut.grid = 6:7
cut.side = 1
# Nov 19: 0.025, from 0.010: on the subtrees two whole-tree runs both closed, the same trees for 0.65 of the
# CPU (zone_nov19/README.md)
cut.zone = 0.025
cut.warmy = 1
cut.rounds = 12
cut.iters = 200
cut.freeze = 1000
cut.damp1 = 0.3
cut.cp = 100:1000
# Nov 19: the bound lab's sko49 policy block (experiments/bound_lab/wil50_policy, arm hoe2w: 1.21x and 1.34x
# fewer iterations on two sko49 subtrees): early entry, the hand-over rule fitted on sko49, and the
# phase's own penalty at wc=1.4 (in dnn.beta_sched below; 0.7 until Nov 19). In sko42.par and sko49.par alike
dnn.giveup_warm = 100
cut.handover = 27:0:5
# Nov 20: dnn.retry = 1, as tho40c: a pooled first solve that fails (its certified bound more than 1% of the
# incumbent below the inherited one) is solved again without the pool, then cold. Without it one such node
# grew 36:7,28:0 of sko42-261120 to 236,000 nodes and 387 CPU h, and three made z25's tails (189 CPU h)
dnn.retry = 1
ship.bits = 32
dnn.beta_sched = two,f=1.6667,t=60,w=0.25,wc=1.4
dnn.cross = 2
dnn.lazycert = 1
# dnn.depths = 1:40 since Nov 14 (1:4 before): the DNN bound at every depth with two
# facilities left (m >= 2 in latest/bnb.C). 1:4 with dnn.ext = 20 reached the same nodes
# down to depth 24 (below depth 4 a node got the bound when its parent was a DNN miss)
# and left the depths below 24 to QPB alone, where a run that must find or beat
# the incumbent goes on its way to a leaf (experiments/estimates/README.md).
dnn.depths = 0:40
dnn.maxgap = 1
dnn.giveup = 300
dnn.warm = 1

# --- sko42_d2r10_sb (Nov 23): experiments/estimates/sko42/sko42.par with two changes, Nathan's choice for sko42's
# next run. The evidence is on claude/cool-babbage-ilnogj, experiments/branching_lab/ucheap (README.md, "sko42 and
# tai35b"; suggest/README.md; sko42sub/predictions.txt; sko42root/).
#
# 1. Rule 10 (every line, the size score on the children's QPB bounds) at depth 2 only: the second and third
#    blocks above, 25 lookahead iterations as measured. Over five depth-2 subtrees of sko42-261120b, cold starts:
#    0.51 of rule 9's nodes, 0.70 of its CPU; from depth 3 down rule 9 was the best of rules 9, 10 and 11, so it
#    stays there. Rule 10 needs branch.la_exp.
branch.la_exp = 32

# 2. DNN strong branching at the root and depth 1, as infra/phase1/recipes/tho40c_sb.par: every row at the root
#    (8th-power score), 4 rows and 4 columns by marginal score at depth 1 (plain sum). dnn.depths starts at 0 for
#    the root's own DNN bound, which the firing needs (1:40 in sko42.par).
#    The root's firing with this file, run alone (ucheap/sko42root): r22, score 1.057 (r35 1.233, r1 1.250,
#    r5 1.302; r36, the row of sko42-261120b, 1.779, tenth of 42); 504 child solves, none retried, 3.5 CPU h on
#    one process. So this run is another tree than sko42-261120b from the first branching: the depth-2 evidence
#    in 1 and the depth-1 probe (experiments/sb_depth1: rule 9's line at 11 of 12 nodes, 18 CPU h) are from
#    r36's tree, no tree under r22 has been measured, and the run's total cannot be split between the two changes.
sb.depths = 0:1
sb.all = 0

# --- sko42_d2r10_sb_early (Nov 27): sko42_d2r10_sb.par, the file of sko42-261124 (kept unedited: that run's
# states carry its hash), with sb.early = 2: a candidate line is left once its partial score passes the best
# complete line's, and its other children are not solved; the line chosen is the same, so the tree is that
# run's. wil50's firings replayed from their saved child solves needed 194 of 750 child solves at the root
# and 213 of 376 at a depth-1 node (experiments/sb_early on claude/cool-babbage-ilnogj); strong branching
# was 30.8 of sko42-261124's 326.9 CPU h. Not run on sko42.
sb.early = 2
