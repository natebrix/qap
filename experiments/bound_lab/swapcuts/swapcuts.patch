+// swapcuts (experiments/bound_lab/swapcuts): an external objective term the caller rewrites
+// between rounds of dnn_cut_rounds. L: (m^2+1)^2 row-major, unscaled, added to every round's
+// objective; abs_: the sum of its terms' magnitudes; cnst: subtracted from the shift. update is
+// called after each round's solve and separation, before the Polyak step, with the last primal
+// iterate and that solve's certified bound (round >= 0), and once with round = -1 before the
+// quiet round (restore the term of the best round).
+struct DNNExtHook {
+  void *ctx;
+  void (*update)(DNNExtHook *h, const std::vector<double> &Y, double lb_now, double best_lb, double cutoff, int round);
+  double *L; double abs_, cnst;
+};
+
 struct DNNCutParams {
+  DNNExtHook *ext_hook;  // NULL: none (default)
   int warm_primal;    // opt-in same-node Y/Z restart between rounds (0); see DNNParams
   int rounds;         // cut rounds after the uncut solve (12)
   int iters;          // iterations per cut round (300)
