0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
4    number of branching rules

0.20 use this rule when gap is worse than...
2    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
4    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 12   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 3    compute B for best _ rows of U

0.0 use this rule when gap is worse than... (all nodes thru depth 6 use rule 8)
6    use this rule thru this depth.
 9    branching rule at top of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 2    branching rule at bottom of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

[settings]
# tho40's current settings (experiments/estimates/README.md): the Nov 8 nug30 record
# recipe (infra/phase1/recipes/nug30.par: rule 9, DNN at depths 1-7, give-up 200, no cut
# phase, ship.bits = 64) with branch.xbar_lines = 2, the setting the tho40 A/B of Nov 9
# carries into any long run (experiments/xbar_lines_sweep/tho40_ab/: 723 to 581 nodes on
# three depth-3 subtrees). Identical to that A/B's logs/x2.par.
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.cheb = 3
dnn.tight_lam = 2
dnn.beta = 0.21
dnn.refresh = 120
dnn.warm_y = 2
dnn.ext = 20
dnn.gu_zone = 0
ship.bits = 64
dnn.cross = 2
dnn.lazycert = 1
dnn.beta_sched = w=0.36,wc=2.88
# dnn.depths = 1:38 since Nov 14 (1:7 before): the DNN bound at every depth with two
# facilities left (m >= 2 in latest/bnb.C). 1:7 with dnn.ext = 20 reached the same nodes
# down to depth 27 (below depth 7 a node got the bound when its parent was a DNN miss)
# and left the depths below 27 to QPB alone, where a run that must find or beat
# the incumbent goes on its way to a leaf (experiments/estimates/README.md).
dnn.depths = 1:38
dnn.maxgap = 1
dnn.giveup = 200
dnn.warm = 1
branch.xbar_lines = 2
# --- bound_lab/tho40_search cut arm zall (a zone covering every give-up): base (experiments/estimates/tho40/tho40.par) plus the grid cut phase
pool.on = 1
cut.grid = 5:8
cut.side = 1
cut.cp = 100:1000
cut.warmy = 1
cut.rounds = 12
cut.iters = 200
cut.freeze = 1000
cut.damp1 = 0.3
cut.zone = 0.06
# --- stop study (stop/): the hand-over rule in place of the stall rule; needs the patched solver (stop/handover.patch)
cut.handover = 20:0:0.22:1.5:100:3:1.25
# --- and dnn.gu_zone = 0 (set above)
# --- and an earlier hand-over from the first solve to the phase: a warm-started node may give up from iteration 100
dnn.giveup_warm = 100
# --- third study (stop/, "With the faster phase"): the phase at its own penalty (cpfast: wc=2.88, set above) and the
# hand-over rule refit: children's cost m x (20 + 0.22 g^3), rate over the last 100 iterations, and the marginal
# condition (KAPPA 1.25). Needs the combined solver (stop/combined.patch).
# --- and near misses keep the warm penalty (cpfast.patch)
cut.cp_wc_gap = 300
# (zallhwf: the same settings, run with the hand-over rule's flat-start guard: stop/combined.patch as delivered)
