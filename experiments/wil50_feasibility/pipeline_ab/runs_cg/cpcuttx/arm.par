pool.on = 1
dnn.refresh = 40
cut.side = 1
cut.rounds = 12
dnn.warm_y = 2
cut.giveup = 200:35,300:25,400:20,600:12
dnn.beta = 0.3
dnn.beta_sched = two,f=1.6667,t=60,w=0.25,wc=0.7
dnn.ext = 20
dnn.gu_zone = 0
ship.bits = 32
dnn.gamma1 = 1.0
cut.cp = 100:1000
dnn.amx = 1
cut.warmy = 1
dnn.lazycert = 1
dnn.tight_lam = 2
dnn.cross = 2
cut.damp1 = 0.3
cut.zone = 0.0075
