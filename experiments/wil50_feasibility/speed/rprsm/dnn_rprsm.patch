+/*
+ DNN_RPRSM: the pieces of Graham, Hu, Im, Li and Wolkowicz's restricted PRSM
+ (INFORMS J. Comput. 2022, arXiv 2006.01529, Algorithm 3.1 and Remark 2.9)
+ that the default iteration does not have; bits, off by default:
+   1  trace-constrained R-step: R = P_{R}(W) over R = {R psd, tr R = m+1},
+      i.e. the eigenvalues projected onto the simplex, R = (W - tau I)_+.
+      Formed as W - tau I minus the computed part below tau, so
+      W - R - tau I = sum_{theta<tau} (theta - tau) x x' is negative
+      semidefinite by construction and V'Z'V = beta (W - R) <= beta tau I;
+      the certificate starts Rump's test at that shift (certify, lam0).
+   2  doubly stochastic projection in the Y-step: the x-row Y_0,(ij) =
+      Y_(ij),0 is projected onto {x >= 0, row and column sums 1} (with
+      eliminated assignments at 0) instead of clipped to [0, 1].
+   4  restricted dual update (Algorithm 3.1): Z starts in Z_A (arrow and
+      diagonal entries equal to -L) and both dual updates are projected onto
+      Z_0, so those entries never move.
+   8  with 2: the arrow too, Y_(ij),(ij) = x_ij (Lemma 2.7: diag Y equals
+      the first column), x = P_DS of the average (2 t_0 + t_diag) / 3.
+ None of them touches the certificate's assumptions: it holds for every
+ symmetric multiplier and every lambda >= lambda_max(V'Z'V) of either sign
+ (trace R = m+1 exactly for every lifted permutation). experiments/
+ wil50_feasibility/speed/rprsm/README.md has the measurements.
+*/
+int rprsm_env()
+{
+  static const int v = getenv("DNN_RPRSM") ? atoi(getenv("DNN_RPRSM")) : 0;
+  return v;
+}
+
+// tau with sum_i max(lambda_i - tau, 0) = target, from the n lowest eigenvalues
+// th[0..n) (ascending) of a K x K matrix with trace trW. When n < K the others
+// are assumed to be >= th[n-1]; if tau would lie above th[n-1] it is capped
+// there (*capped), since the block does not know those eigenvalues.
+template <class T>
+double trace_tau(const T *th, int n, int K, double trW, double target, bool *capped)
+{
+  *capped = false;
+  double S = 0;
+  for (int k = 0; k < n; k++) {
+    // tau in (th[k-1], th[k]]: f(tau) = trW - S_k - (K - k) tau
+    const double t = (trW - S - target) / (K - k);
+    if (t <= (double)th[k]) return t;
+    S += (double)th[k];
+  }
+  *capped = n < K;
+  return n > 0 ? (double)th[n - 1] : (trW - target) / K;
+}
+
+// threshold s with sum_j max(a_j - s, 0) = 1 over the n values a (simplex
+// projection of a row); scratch b (n)
+static double simplex_shift(const double *a, int n, double *b)
+{
+  for (int j = 0; j < n; j++) b[j] = a[j];
+  std::sort(b, b + n, [](double p, double q) { return p > q; });
+  double cs = 0, s = b[0] - 1;
+  for (int j = 0; j < n; j++) {
+    cs += b[j];
+    const double t = (cs - 1) / (j + 1);
+    if (j + 1 == n || b[j + 1] <= t) { s = t; break; }
+  }
+  return s;
+}
+
+/*
+ x = argmin |x - t| over {x >= 0, x e = e, x'e = e, x_ij = 0 for eliminated
+ (i,j)} (m x m, row-major). Block-coordinate ascent on the dual,
+ x_ij = max(t_ij - u_i - v_j, 0): each half-sweep is m simplex projections.
+ u, v are warm from the last call. Stops when every row and column sum is
+ within tol of 1, or after maxsweep sweeps (an inexact projection only moves
+ the ADMM iterate, never the certificate).
+*/
+static int ds_project(Work &w, const double *t, double *x, double tol, int maxsweep)
+{
+  const int m = w.m;
+  if ((int)w.ds_u.size() != m) { w.ds_u.assign(m, 0); w.ds_v.assign(m, 0); }
+  w.ds_s.resize(2 * (size_t)m);
+  double *a = w.ds_s.data(), *b = a + m;
+  double *u = w.ds_u.data(), *v = w.ds_v.data();
+  const unsigned char *el = w.elim;
+  int sw = 0;
+  for (; sw < maxsweep; sw++) {
+    for (int i = 0; i < m; i++) {
+      int n = 0;
+      for (int j = 0; j < m; j++) if (!el || !el[i * m + j]) a[n++] = t[i * m + j] - v[j];
+      u[i] = simplex_shift(a, n, b);
+    }
+    for (int j = 0; j < m; j++) {
+      int n = 0;
+      for (int i = 0; i < m; i++) if (!el || !el[i * m + j]) a[n++] = t[i * m + j] - u[i];
+      v[j] = simplex_shift(a, n, b);
+    }
+    // columns now sum to 1 exactly (up to rounding); check the rows
+    double err = 0;
+    for (int i = 0; i < m; i++) {
+      double s = 0;
+      for (int j = 0; j < m; j++)
+        if (!el || !el[i * m + j]) s += std::max(t[i * m + j] - u[i] - v[j], 0.0);
+      err = std::max(err, fabs(s - 1));
+    }
+    if (err < tol) { sw++; break; }
+  }
+  for (int i = 0; i < m; i++)
