 namespace {
 
+// EXPERIMENT: round a float array to bfloat16 (round to nearest even), keeping float storage
+inline void round_bf16(const float *src, float *dst, size_t n)
+{
+  for (size_t t = 0; t < n; t++) {
+    unsigned u; memcpy(&u, &src[t], 4);
+    static const int drop = getenv("DNN_ROUND_BITS") ? atoi(getenv("DNN_ROUND_BITS")) : 16;
+    const unsigned half = 1u << (drop - 1), mask = ~((1u << drop) - 1u);
+    u += (half - 1u) + ((u >> drop) & 1u); u &= mask;
+    memcpy(&dst[t], &u, 4);
+  }
+}
+
