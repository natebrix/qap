0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
4    number of branching rules

0.20 use this rule when gap is worse than...
2    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
4    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 12   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 3    compute B for best _ rows of U

0.0 use this rule when gap is worse than... (all nodes thru depth 6 use rule 8)
6    use this rule thru this depth.
 9    branching rule at top of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 2    branching rule at bottom of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

[settings]
# The full wil50 run (README.md here): the cpcutt arm of
# ../pipeline_ab/run_pair.sh (its 24 QAP_DNN_*/DNN_* exports, Nov 7) as keys,
# then the sampling plan's depth spec, -x 1:4:1:300:1: the DNN bound from
# depth 1 through depth 4 (dnn.ext = 20 levels below a last-level miss), give
# up after 300 iterations when hopeless, children warm-started from the parent.
# dnn.beta = 0.3 and dnn.gu_zone = 0 are pinned: 34e347c (Nov 8) changed those
# defaults and the gated arm and stages A and B ran the old values.
# Change only in a commit that means to change the full run, and regenerate
# settings.golden in it (settings.sh, fullrun_check).
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.ext = 20
dnn.amx = 1
dnn.cheb = 3
dnn.tight_lam = 2
dnn.refresh = 40
dnn.warm_y = 2
pool.on = 1
dnn.beta = 0.3
dnn.gu_zone = 0
cut.grid = 5:10
cut.side = 1
cut.zone = 0.005
cut.warmy = 1
cut.rounds = 12
cut.iters = 200
cut.freeze = 1000
cut.damp1 = 0.3
cut.cp = 100:1000
ship.bits = 32
dnn.beta_sched = two,f=1.6667,t=60,w=0.25,wc=0.7
dnn.cross = 2
dnn.lazycert = 1
dnn.depths = 1:4
dnn.maxgap = 1
dnn.giveup = 300
dnn.warm = 1
