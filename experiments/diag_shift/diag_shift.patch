diff --git a/latest/shiftexp.C b/latest/shiftexp.C
new file mode 100644
index 0000000..bcaa3cb
--- /dev/null
+++ b/latest/shiftexp.C
@@ -0,0 +1,172 @@
+// EXPERIMENT (scratch only): per-node diagonal shift A + Diag(d).
+// Env switches:
+//   QAP_SHIFT_DEPTH  apply at node depth <= this (default -1: off)
+//   QAP_SHIFT_MINM   only when the reduced size m >= this (default 4)
+//   QAP_SHIFT_STEPS  ascent steps (default 5)
+//   QAP_SHIFT_MODE   0 eigen-term proxy, 1 PB proxy (eigen + LAP), default 1
+//   QAP_SHIFT_STEP   base step, in units of mean |A_ij| (default 0.8)
+//   QAP_SHIFT_GUARD  1: also compute the unshifted bound, keep the better
+//   QAP_SHIFT_WHICH  0 shift A, 1 shift B (default 0)
+#include "shiftexp.h"
+#include "linalg.h"
+#include "dlap.h"
+#include <cstdlib>
+#include <cmath>
+#include <vector>
+#include <algorithm>
+#include <cstdio>
+
+static int envi(const char *k, int d) { const char *v = getenv(k); return v ? atoi(v) : d; }
+static double envd(const char *k, double d) { const char *v = getenv(k); return v ? atof(v) : d; }
+
+int shx_depth = envi("QAP_SHIFT_DEPTH", -1);
+int shx_minm = envi("QAP_SHIFT_MINM", 4);
+int shx_steps = envi("QAP_SHIFT_STEPS", 5);
+int shx_mode = envi("QAP_SHIFT_MODE", 1);
+double shx_step = envd("QAP_SHIFT_STEP", 0.8);
+int shx_guard = envi("QAP_SHIFT_GUARD", 0);
+int shx_which = envi("QAP_SHIFT_WHICH", 0);
+double shx_g_all = 0, shx_g_pos = 0; long shx_n_all = 0;
+long shx_calls = 0; double shx_gain_sum = 0; long shx_better = 0;
+
+bool shift_wanted(int depth, int m) { return depth <= shx_depth && m >= shx_minm; }
+
+// (V q)_k for the basis vtav() uses: V[0][i] = k1, V[k][i] = k2 + (k == i+1)
+static void lift(const double *q, int m1, double *out)
+{
+  const int n = m1 + 1;
+  const double k1 = -1.0/sqrt((double)n), k2 = -1.0/(n + sqrt((double)n));
+  double s = 0; for (int i = 0; i < m1; i++) s += q[i];
+  out[0] = k1*s;
+  for (int k = 1; k < n; k++) out[k] = k2*s + q[k-1];
+}
+
+// proxy value and supergradient for the shift d of P (P = A or B), Q the other matrix
+static double proxy(MAT *P, MAT *Qm, MAT *C, const std::vector<double> &d, bool shiftA,
+		    const std::vector<double> &mu_asc, std::vector<double> &g)
+{
+  const int n = P->m, m1 = n - 1;
+  MAT *Ps = m_copy(P, MNULL);
+  for (int i = 0; i < n; i++) Ps->me[i][i] += d[i];
+  MAT *H = m_get(m1, m1);
+  vtav(Ps, H);
+  VEC *lam = v_get(m1);
+  my_svd(H, lam);              // rows of H = eigenvectors
+  std::vector<int> ord(m1);
+  for (int i = 0; i < m1; i++) ord[i] = i;
+  std::sort(ord.begin(), ord.end(), [&](int a, int b){ return lam->ve[a] > lam->ve[b]; });
+  double val = 0;
+  g.assign(n, 0.0);
+  std::vector<double> v(n);
+  for (int r = 0; r < m1; r++) {
+    int i = ord[r];
+    val += lam->ve[i]*mu_asc[r];
+    lift(H->me[i], m1, &v[0]);
+    for (int k = 0; k < n; k++) g[k] += mu_asc[r]*v[k]*v[k];
+  }
+  if (shx_mode == 1) {
+    // PB: + LAP(C' + (2/n) rP rQ') - sP sQ / n^2, with C' the shift-corrected C
+    std::vector<double> rP(n, 0.0), rQ(n, 0.0);
+    double sP = 0, sQ = 0;
+    for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) { rP[i] += Ps->me[i][j]; rQ[i] += Qm->me[i][j]; }
+    for (int i = 0; i < n; i++) { sP += rP[i]; sQ += rQ[i]; }
+    double **L = new double*[n];
+    for (int i = 0; i < n; i++) {
+      L[i] = new double[n];
+      for (int j = 0; j < n; j++) {
+	// row index i is a facility (row of X) when shifting A, a location (column) when shifting B
+	double c = shiftA ? C->me[i][j] - d[i]*Qm->me[j][j] : C->me[j][i] - d[i]*Qm->me[j][j];
+	L[i][j] = c + 2.0/n*rP[i]*rQ[j];
+      }
+    }
+    int *x = new int[n], *y = new int[n]; double *u = new double[n], *w = new double[n];
+    double lap = dlap(n, L, x, y, u, w, 1.0);
+    val += lap - sP*sQ/((double)n*n);
+    for (int k = 0; k < n; k++) g[k] += 2.0/n*rQ[x[k]] - Qm->me[x[k]][x[k]] - sQ/((double)n*n);
+    for (int i = 0; i < n; i++) delete [] L[i];
+    delete [] L; delete [] x; delete [] y; delete [] u; delete [] w;
+  }
+  V_FREE(lam); M_FREE(H); M_FREE(Ps);
+  return val;
+}
+
+// Shift the reduced problem in place: A += Diag(d) (or B), C corrected so
+// every permutation keeps its objective.
+void apply_shift(MAT *A, MAT *B, MAT *C, std::vector<double> *out)
+{
+  const bool shiftA = (shx_which == 0);
+  MAT *P = shiftA ? A : B, *Qm = shiftA ? B : A;
+  const int n = P->m, m1 = n - 1;
+  // eigenvalues of V'QV, ascending
+  MAT *H = m_get(m1, m1);
+  vtav(Qm, H);
+  VEC *mu = v_get(m1);
+  my_svd(H, mu);
+  std::vector<double> mu_asc(mu->ve, mu->ve + m1);
+  std::sort(mu_asc.begin(), mu_asc.end());
+  V_FREE(mu); M_FREE(H);
+
+  double scale = 0; int cnt = 0;
+  for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) if (i != j) { scale += fabs(P->me[i][j]); cnt++; }
+  scale = cnt ? scale/cnt : 1.0;
+  if (scale == 0) scale = 1.0;
+
+  std::vector<double> d(n, 0.0), g, best_d(n, 0.0);
+  double v0 = proxy(P, Qm, C, d, shiftA, mu_asc, g), best = v0;
+  for (int it = 0; it < shx_steps; it++) {
+    double mean = 0; for (int k = 0; k < n; k++) mean += g[k]; mean /= n;
+    double nrm = 0; for (int k = 0; k < n; k++) { g[k] -= mean; nrm += g[k]*g[k]; }
+    nrm = sqrt(nrm);
+    if (nrm < 1e-12) break;
+    double st = shx_step*scale/sqrt(it + 1.0)*sqrt((double)n)/nrm;
+    for (int k = 0; k < n; k++) d[k] += st*g[k];
+    double v = proxy(P, Qm, C, d, shiftA, mu_asc, g);
+    if (v > best) { best = v; best_d = d; }
+  }
+  shx_calls++; shx_gain_sum += best - v0;
+  if (out) *out = best_d;
+  for (int i = 0; i < n; i++) P->me[i][i] += best_d[i];
+  for (int i = 0; i < n; i++)
+    for (int j = 0; j < n; j++) {
+      if (shiftA) C->me[i][j] -= best_d[i]*B->me[j][j];
+      else        C->me[i][j] -= A->me[i][i]*best_d[j];   // tr(A X E X') = sum_i a_ii e_p(i)
+    }
+}
+
+void shift_report()
+{
+  if (shx_depth >= 0)
+    fprintf(stderr, "shift: %ld nodes, mean proxy gain %.3f, guarded better %ld, mean QPB change %.3f, mean gain when better %.3f\n",
+	    shx_calls, shx_calls ? shx_gain_sum/shx_calls : 0.0, shx_better, shx_n_all ? shx_g_all/shx_n_all : 0.0, shx_better ? shx_g_pos/shx_better : 0.0);
+}
+
+// mode 2: one step along diag(X B X') (the d-gradient of the QP objective at X,
+// ignoring how S,T react), zero mean, length step*scale*sqrt(n)
+void apply_shift_X(MAT *A, MAT *B, MAT *C, MAT *X)
+{
+  const int n = A->m;
+  std::vector<double> g(n, 0.0);
+  MAT *XB = m_mlt(X, B, MNULL);
+  for (int k = 0; k < n; k++) for (int j = 0; j < n; j++) g[k] += XB->me[k][j]*X->me[k][j];
+  M_FREE(XB);
+  double mean = 0; for (int k = 0; k < n; k++) mean += g[k]; mean /= n;
+  double nrm = 0; for (int k = 0; k < n; k++) { g[k] -= mean; nrm += g[k]*g[k]; }
+  nrm = sqrt(nrm);
+  if (nrm < 1e-12) return;
+  double scale = 0; int cnt = 0;
+  for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) if (i != j) { scale += fabs(A->me[i][j]); cnt++; }
+  scale = cnt ? scale/cnt : 1.0;
+  double st = shx_step*scale*sqrt((double)n)/nrm;
+  for (int i = 0; i < n; i++) A->me[i][i] += st*g[i];
+  for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) C->me[i][j] -= st*g[i]*B->me[j][j];
+  shx_calls++;
+}
+
+// apply a given A shift d (length m)
+void apply_shift_d(MAT *A, MAT *B, MAT *C, const std::vector<double> &d)
+{
+  const int n = A->m;
+  for (int i = 0; i < n; i++) A->me[i][i] += d[i];
+  for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) C->me[i][j] -= d[i]*B->me[j][j];
+}
+int shx_inherit = envi("QAP_SHIFT_INHERIT", 0);
