+#ifndef SHIFTEXP_H
+#define SHIFTEXP_H
+#include <vector>
+#include "meschach.h"
+#undef catch
+extern int shx_guard; extern double shx_g_all, shx_g_pos; extern long shx_n_all; extern long shx_better;
+bool shift_wanted(int depth, int m);
+void apply_shift(MAT *A, MAT *B, MAT *C, std::vector<double> *out = NULL);
+void apply_shift_d(MAT *A, MAT *B, MAT *C, const std::vector<double> &d);
+extern int shx_inherit;
+void apply_shift_X(MAT *A, MAT *B, MAT *C, MAT *X);
+extern int shx_mode;
+void shift_report();
+#endif
