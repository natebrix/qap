diff --git a/latest/dominance.C b/latest/dominance.C
new file mode 100644
index 00000000..597e345f
--- /dev/null
+++ b/latest/dominance.C
@@ -0,0 +1,123 @@
+// Pair exchange dominance: see dominance.h.
+#include "dominance.h"
+#include "util.h"
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+
+static bool mat_symmetric(MAT *M)
+{
+  for (unsigned int i = 0; i < M->m; i++)
+    for (unsigned int j = i + 1; j < M->n; j++)
+      if (M->me[i][j] != M->me[j][i]) return false;
+  return true;
+}
+
+// v * scale as an exact integer of magnitude below lim, or false
+static bool scaled_int(double v, double scale, double lim, long long &out)
+{
+  const double s = v * scale;            // exact: a power-of-two scale
+  if (s != std::floor(s) || std::fabs(s) >= lim) return false;
+  out = (long long)s;
+  return true;
+}
+
+bool PairDominance::init(QAP *q, std::string &why)
+{
+  ok = false;
+  n = q->A->m;
+  if (!(DELTA > 0.5)) {
+    why = "the data are not integers evaluated exactly (set_fathom_tolerance)";
+    return false;
+  }
+  if (!mat_symmetric(q->A) || !mat_symmetric(q->B)) {
+    why = "A and B are not both symmetric after symmetrize_QAP";
+    return false;
+  }
+  const double L31 = 2147483648.0, L60 = 1152921504606846976.0;
+  A2.assign((size_t)n * n, 0);
+  B2.assign((size_t)n * n, 0);
+  C4.assign((size_t)n * n, 0);
+  for (int i = 0; i < n; i++)
+    for (int j = 0; j < n; j++) {
+      if (!scaled_int(q->A->me[i][j], 2.0, L31, A2[(size_t)i * n + j]) ||
+          !scaled_int(q->B->me[i][j], 2.0, L31, B2[(size_t)i * n + j]) ||
+          !scaled_int(q->C->me[i][j], 4.0, L60, C4[(size_t)i * n + j])) {
+        why = "an entry of 2A, 2B or 4C is not an integer of the supported size";
+        return false;
+      }
+    }
+  ok = true;
+  return true;
+}
+
+__int128 PairDominance::pair_min4(const QAPAssignment &node, int i, int k) const
+{
+  const int a = node.p[i], b = node.p[k];
+  __int128 v = (__int128)(a2(i, i) - a2(k, k)) * (b2(a, a) - b2(b, b))
+             + (__int128)c4(i, a) + c4(k, b) - c4(i, b) - c4(k, a);
+  std::vector<long long> x, y;
+  x.reserve(n);
+  y.reserve(n);
+  for (int l = 0; l < n; l++) {
+    const int c = node.p[l];
+    if (c >= 0) {
+      if (l != i && l != k)
+        v += (__int128)2 * (a2(i, l) - a2(k, l)) * (b2(a, c) - b2(b, c));
+    } else {
+      x.push_back(a2(i, l) - a2(k, l));
+    }
+  }
+  for (int c = 0; c < n; c++)
+    if (node.pinv[c] < 0) y.push_back(b2(a, c) - b2(b, c));
+  // x ascending against y descending: the minimum of sum x_l y_sigma(l)
+  std::sort(x.begin(), x.end());
+  std::sort(y.begin(), y.end(), [](long long u, long long w) { return u > w; });
+  __int128 s = 0;
+  for (size_t j = 0; j < x.size(); j++) s += (__int128)x[j] * y[j];
+  return v + 2 * s;
+}
+
+bool PairDominance::dominated(const QAPAssignment &node, int *pi, int *pk, long long *best4, bool full) const
+{
+  *pi = *pk = -1;
+  *best4 = LLONG_MIN;
+  if (!ok || node.n != n) return false;
+  // the fixed rows, in the order they were fixed; the node must be a
+  // consistent partial permutation (else: no test)
+  std::vector<int> rows;
+  int ncols = 0;
+  for (int l = 0; l < n; l++) if (node.p[l] >= 0) rows.push_back(node.p[l] >= n ? -1 : l);
+  for (int c = 0; c < n; c++) if (node.pinv[c] >= 0) ncols++;
+  if ((int)rows.size() != ncols || (int)rows.size() < 2) return false;
+  for (int l : rows) if (l < 0 || node.pinv[node.p[l]] != l) return false;
+  std::vector<int> order;
+  for (int h = 0; h < node.nfix; h++) {
+    const int r = node.history[h];
+    if (r >= 0 && r < n && node.p[r] >= 0) order.push_back(r);
+  }
+  if (order.size() != rows.size()) order = rows;   // (history incomplete: by index)
+
+  bool dom = false;
+  __int128 best = 0;
+  bool have = false;
+  for (size_t u = 0; u < order.size(); u++)
+    for (size_t w = u + 1; w < order.size(); w++) {
+      const __int128 v = pair_min4(node, order[u], order[w]);
+      if (!have || v > best) {
+        best = v; have = true;
+        *pi = order[u]; *pk = order[w];
+      }
+      if (v > 0) {
+        dom = true;
+        if (!full) goto done;
+      }
+    }
+done:
+  if (have) {
+    const __int128 cap = (__int128)LLONG_MAX;
+    *best4 = best > cap ? LLONG_MAX : (best < -cap ? -LLONG_MAX : (long long)best);
+  }
+  return dom;
+}
diff --git a/latest/dominance.h b/latest/dominance.h
new file mode 100644
index 00000000..2f3aec4c
--- /dev/null
+++ b/latest/dominance.h
@@ -0,0 +1,72 @@
+/*
+============================================================
+
+ Pair exchange dominance (dom.pair; bnb.C, at pop, before any bound).
+
+ cost(p) = sum_uv A[u][v] B[p(u)][p(v)] + sum_u C[u][p(u)]. A node N fixes
+ row i at column a and row k at column b. For a completion p of N, let p' be
+ p with i and k exchanged (p'(i) = b, p'(k) = a), and Delta(p) = cost(p) -
+ cost(p'). With A and B symmetric (as they are after symmetrize_QAP):
+
+   Delta(p) = (A[i][i]-A[k][k]) (B[a][a]-B[b][b])
+            + C[i][a] + C[k][b] - C[i][b] - C[k][a]
+            + sum_{l != i,k} 2 (A[i][l]-A[k][l]) (B[a][p(l)]-B[b][p(l)])
+
+ The fixed rows l give a constant; over the free rows the sum is a linear
+ assignment problem with the rank-one cost x_l y_c, whose minimum is x sorted
+ ascending against y sorted descending (rearrangement inequality). If that
+ minimum is > 0 for some pair, every completion of N has a strictly cheaper
+ exchange image, so N holds no optimal solution and can be dropped. The
+ test does not read the incumbent, the bound, or the node's eliminated
+ variables (it minimises over all completions of the fixes, a superset of
+ the node's, so it is conservative where variables are eliminated).
+
+ Exactness: everything is computed in integers, on 2A, 2B and 4C (the
+ symmetrised matrix holds halves), so the value is 4 min Delta exactly and
+ the test is "> 0" with no tolerance: strict, so a tie never drops a node
+ (experiments/branching_lab/dominance/README.md, esc08a). The test is
+ available only when the original data are integers that the solver
+ evaluates exactly (DELTA > 0, set_fathom_tolerance), both matrices are
+ symmetric after symmetrize_QAP, and the scaled entries fit (|2A|, |2B| <
+ 2^31, |4C| < 2^60, so a 128-bit sum cannot overflow); otherwise it never
+ fires and init() says why.
+
+============================================================
+*/
+#ifndef DOMINANCE_H
+#define DOMINANCE_H
+
+#include <string>
+#include <vector>
+#include <cstdint>
+#include "qap.h"
+#include "assign.h"
+
+class PairDominance
+{
+public:
+  PairDominance() : ok(false), n(0) {}
+  // read q (the objective bnb() uses); false: the test is unavailable, why says why
+  bool init(QAP *q, std::string &why);
+  bool available() const { return ok; }
+
+  // true when some pair of fixed rows dominates the node. *pi, *pk: that pair
+  // (original row indices); *best4: 4 x its min Delta. With full, every pair is
+  // evaluated and *best4 is the largest 4 min Delta over the pairs (the pair
+  // that attains it in *pi, *pk); otherwise it stops at the first pair > 0.
+  // Fewer than two fixed rows: false, *pi = *pk = -1, *best4 = INT64_MIN.
+  bool dominated(const QAPAssignment &a, int *pi, int *pk, long long *best4, bool full = false) const;
+
+  // 4 min Delta for the pair (i, k) of fixed rows (no checks)
+  __int128 pair_min4(const QAPAssignment &a, int i, int k) const;
+
+private:
+  bool ok;
+  int n;
+  std::vector<long long> A2, B2, C4;   // 2A, 2B, 4C, row-major n x n
+  long long a2(int i, int j) const { return A2[(size_t)i * n + j]; }
+  long long b2(int i, int j) const { return B2[(size_t)i * n + j]; }
+  long long c4(int i, int j) const { return C4[(size_t)i * n + j]; }
+};
+
+#endif
