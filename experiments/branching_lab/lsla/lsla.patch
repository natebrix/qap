+// lsla.h: the landscape signal in C (experiments/branching_lab/lsla; an experiment build, never cognac's latest/).
+// For a node (some rows fixed) and an incumbent permutation p* (p[i] = the column of row i), every free
+// cell (r, v) gets the best completion a 2-exchange descent plus KICKS kicks (each KSIZE random
+// exchanges then a descent, kept when better) finds with the node's fixes and r:v forced. The delta
+// table is Taillard's: O(n^3) once per node, O(m^2) per exchange after; a child's table is the node's
+// best completion's table updated by one exchange (r with the row that holds v), so a child costs
+// O(m^2) to set up instead of O(n^3).
+#ifndef LSLA_H
+#define LSLA_H
+#include <vector>
+
+struct LSInst {
+  int n = 0;
+  std::vector<double> a, b, c;   // n x n row-major; c the linear term (all zero if none)
+  bool has_c = false;
+  double shift = 0;
+  double cost(const int *p) const;
+};
+
+struct LSParams {
+  int kicks = 30;        // kicks per child
+  int kicks2 = 0;        // more kicks for children near the threshold (1 < ex / s <= xhi)
+  double xhi = 2.5;
+  int ksize = 6;         // random exchanges per kick
+  int gate_kicks = 300;  // kicks for the node's own best completion (the gate)
+  int kicks3 = 0;        // > 0: per cell, a second search from a random completion of the node's fixes with the
+                         // cell forced (descent + kicks3 kicks), and the harvest: every local optimum any search
+                         // visits (base, random, refinement) is credited to every free cell it satisfies.
+                         // 0: today's behaviour (no random search, no harvest)
+};
+
+struct LSTable {
+  // local indices: frow[a], fcol[b] are the original row / column of local row a, column b
+  std::vector<int> frow, fcol;
+  int m = 0;
+  double z = 0;                 // the incumbent permutation's cost
+  double ex_node = 0;           // the node's own best completion - z (after gate_kicks)
+  double ex_start = 0;          // the incumbent adjusted to the node's fixes - z (no search)
+  std::vector<double> ex;       // m x m: best completion with r:v forced - z
+  std::vector<double> ex_base;  // the same after the base kicks only (before refinement)
+  long refined = 0;             // cells given kicks2 more kicks
+  long moves = 0;               // descent moves in all
+  double cpu_gate = 0, cpu_table = 0, cpu_refine = 0;
+  double cpu_random = 0;        // the kicks3 searches (inside cpu_table)
+  long harvested = 0;           // cells whose ex the harvest lowered below their own searches' best (kicks3 > 0)
+};
+
+// fixed[r] = column of row r, or -1 when free. pstar: the incumbent permutation (any; its fixes are forced).
+// The gate only (table not built) when gate_only; s = the node's slack (cutoff - bound), for refinement.
+void ls_node(const LSInst &I, const int *pstar, const int *fixed, double s, const LSParams &P,
+	     bool gate_only, LSTable &T, unsigned seed);
+// the rest of the table after a gate-only call
+void ls_table(const LSInst &I, const int *pstar, const int *fixed, double s, const LSParams &P,
+	      LSTable &T, unsigned seed);
+
+// the line scores: cnt = children with ex <= s; off = sum over children with ex > chain_eps of
+// P(x) max(x, 0.05)^-1.07, x = ex / s, P(x) = 1 / (1 + exp(-(0.18 - 4.36 ln x))) (landscape/README.md 4)
+void ls_line_score(const LSTable &T, bool row, int k, double s, double chain_eps, int &cnt, double &off);
+#endif
