+// lsla.C: the landscape signal in C (lsla.h). experiments/branching_lab/lsla; an experiment build only.
+#include "lsla.h"
+#include <cmath>
+#include <cstring>
+#include <ctime>
+#include <cstdint>
+#include <algorithm>
+
+double LSInst::cost(const int *p) const {
+  double s = shift;
+  for (int i = 0; i < n; i++) {
+    const double *ai = &a[(size_t)i * n];
+    const double *bp = &b[(size_t)p[i] * n];
+    for (int k = 0; k < n; k++) s += ai[k] * bp[p[k]];
+    if (has_c) s += c[(size_t)i * n + p[i]];
+  }
+  return s;
+}
+
+namespace {
+
+struct Rng {
+  uint64_t s;
+  explicit Rng(uint64_t seed) : s(seed * 0x9E3779B97F4A7C15ull + 0x2545F4914F6CDD1Dull) { if (!s) s = 1; next(); }
+  uint64_t next() { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return s; }
+  int below(int k) { return (int)((next() >> 11) % (uint64_t)k); }
+};
+
+struct St {
+  std::vector<int> p;      // p[i] = column of row i
+  std::vector<int> f;      // free rows, ascending
+  std::vector<double> D;   // D[i * n + j], i < j both free: the change in cost when rows i and j exchange columns
+  double cost = 0;
+};
+
+inline double dfull(const LSInst &I, const int *p, int i, int j) {
+  const int n = I.n;
+  const double *a = I.a.data(), *b = I.b.data();
+  const int pi = p[i], pj = p[j];
+  double d = (a[i * n + i] - a[j * n + j]) * (b[pj * n + pj] - b[pi * n + pi]) +
+	     (a[i * n + j] - a[j * n + i]) * (b[pj * n + pi] - b[pi * n + pj]);
+  for (int k = 0; k < n; k++) {
+    if (k == i || k == j) continue;
+    const int pk = p[k];
+    d += (a[k * n + i] - a[k * n + j]) * (b[pk * n + pj] - b[pk * n + pi]) +
+	 (a[i * n + k] - a[j * n + k]) * (b[pj * n + pk] - b[pi * n + pk]);
+  }
+  if (I.has_c) {
+    const double *c = I.c.data();
+    d += c[i * n + pj] + c[j * n + pi] - c[i * n + pi] - c[j * n + pj];
+  }
+  return d;
+}
+
+void init(const LSInst &I, St &S) {
+  const int n = I.n;
+  S.cost = I.cost(S.p.data());
+  S.D.assign((size_t)n * n, 0.0);
+  const int m = (int)S.f.size();
+  for (int x = 0; x < m; x++)
+    for (int y = x + 1; y < m; y++) S.D[(size_t)S.f[x] * n + S.f[y]] = dfull(I, S.p.data(), S.f[x], S.f[y]);
+}
+
+// rows u, v (both free) exchange columns; every free pair's delta updated
+void swap(const LSInst &I, St &S, int u, int v) {
+  const int n = I.n;
+  if (u > v) std::swap(u, v);
+  S.cost += S.D[(size_t)u * n + v];
+  std::swap(S.p[u], S.p[v]);
+  const int *p = S.p.data();
+  const double *a = I.a.data(), *b = I.b.data();
+  const int pu = p[u], pv = p[v];
+  const int m = (int)S.f.size();
+  for (int x = 0; x < m; x++) {
+    const int i = S.f[x], pi = p[i];
+    double *Di = &S.D[(size_t)i * n];
+    if (i == u || i == v) {
+      for (int y = x + 1; y < m; y++) Di[S.f[y]] = dfull(I, p, i, S.f[y]);
+      continue;
+    }
+    const double aui = a[u * n + i], avi = a[v * n + i], aiu = a[i * n + u], aiv = a[i * n + v];
+    const double bvi = b[pv * n + pi], bui = b[pu * n + pi], biv = b[pi * n + pv], biu = b[pi * n + pu];
+    for (int y = x + 1; y < m; y++) {
+      const int j = S.f[y];
+      if (j == u || j == v) { Di[j] = dfull(I, p, i, j); continue; }
+      const int pj = p[j];
+      // ls.c's delta_part with r = u, s = v (p already exchanged)
+      Di[j] += (aui - a[u * n + j] + a[v * n + j] - avi) * (bvi - b[pv * n + pj] + b[pu * n + pj] - bui) +
+	       (aiu - a[j * n + u] + a[j * n + v] - aiv) * (biv - b[pj * n + pv] + b[pj * n + pu] - biu);
+    }
+  }
+}
+
+long descent(const LSInst &I, St &S, double eps) {
+  const int n = I.n, m = (int)S.f.size();
+  long moves = 0;
+  if (m < 2) return 0;
+  for (;;) {
+    double best = -eps;
+    int bi = -1, bj = -1;
+    for (int x = 0; x < m; x++) {
+      const double *Di = &S.D[(size_t)S.f[x] * n];
+      for (int y = x + 1; y < m; y++)
+	if (Di[S.f[y]] < best) { best = Di[S.f[y]]; bi = S.f[x]; bj = S.f[y]; }
+    }
+    if (bi < 0) break;
+    swap(I, S, bi, bj);
+    moves++;
+  }
+  return moves;
+}
+
+// the harvest (kicks3 > 0): H[a * m + b] = the least cost of any local optimum seen with p[frow[a]] = fcol[b]
+struct Harvest {
+  std::vector<double> H;
+  const int *rowloc = nullptr, *colloc = nullptr;   // original row / column -> local index (-1 if fixed)
+  int m = 0;
+  void credit(const St &S) {
+    for (int i = 0; i < (int)S.p.size(); i++) {
+      const int a = rowloc[i];
+      if (a < 0) continue;
+      double &h = H[(size_t)a * m + colloc[S.p[i]]];
+      if (S.cost < h) h = S.cost;
+    }
+  }
+};
+
+long ils(const LSInst &I, St &S, int kicks, int ksize, double eps, Rng &R, St &T, Harvest *HV = nullptr) {
+  long moves = 0;
+  const int m = (int)S.f.size();
+  if (HV) HV->credit(S);
+  if (m < 2) return 0;
+  for (int k = 0; k < kicks; k++) {
+    T = S;
+    for (int e = 0; e < ksize; e++) {
+      int x = R.below(m), y = R.below(m - 1);
+      if (y >= x) y++;
+      swap(I, T, T.f[x], T.f[y]);
+    }
+    moves += descent(I, T, eps);
+    if (HV) HV->credit(T);
+    if (T.cost < S.cost - eps) std::swap(S, T);
+  }
+  return moves;
+}
+
+void unfree(St &S, int r) { S.f.erase(std::find(S.f.begin(), S.f.end(), r)); }
+
+double cpu_now() { return (double)clock() / CLOCKS_PER_SEC; }
+
+double eps_of(const LSInst &I) {
+  static thread_local const LSInst *last = nullptr;
+  static thread_local double e = 0.5;
+  if (last != &I) {
+    last = &I;
+    bool integral = true;
+    for (double x : I.a) if (x != std::floor(x)) { integral = false; break; }
+    if (integral) for (double x : I.b) if (x != std::floor(x)) { integral = false; break; }
+    if (integral && I.has_c) for (double x : I.c) if (x != std::floor(x)) { integral = false; break; }
+    e = integral ? 0.5 : 1e-9;
+  }
+  return e;
+}
+
+// the node's states: S0 = the incumbent adjusted to the node's fixes (table built, no descent),
+// NB = the node's best completion; kept between the gate and the table
+struct NodeCache {
+  std::vector<int> key;   // the fixes and the incumbent the states were built for
+  St S0, NB;
+};
+thread_local NodeCache cache;
+
+void node_states(const LSInst &I, const int *pstar, const int *fixed, const LSParams &P, LSTable &T, unsigned seed) {
+  const int n = I.n;
+  const double eps = eps_of(I);
+  St S0;
+  S0.p.assign(pstar, pstar + n);
+  std::vector<int> pos(n);
+  for (int i = 0; i < n; i++) pos[S0.p[i]] = i;
+  for (int r = 0; r < n; r++) {
+    if (fixed[r] < 0 || S0.p[r] == fixed[r]) continue;
+    const int j = pos[fixed[r]];
+    std::swap(S0.p[r], S0.p[j]);
+    pos[S0.p[r]] = r; pos[S0.p[j]] = j;
+  }
+  T.frow.clear(); T.fcol.clear();
+  std::vector<char> colfree(n, 1);
+  for (int r = 0; r < n; r++) {
+    if (fixed[r] < 0) { S0.f.push_back(r); T.frow.push_back(r); }
+    else colfree[fixed[r]] = 0;
+  }
+  for (int c = 0; c < n; c++) if (colfree[c]) T.fcol.push_back(c);
+  T.m = (int)T.frow.size();
+  init(I, S0);
+  T.z = I.cost(pstar);
+  T.ex_start = S0.cost - T.z;
+  St NB = S0, W;
+  T.moves += descent(I, NB, eps);
+  Rng R(seed);
+  T.moves += ils(I, NB, P.gate_kicks, P.ksize, eps, R, W);
+  T.ex_node = NB.cost - T.z;
+  cache.S0 = std::move(S0);
+  cache.NB = std::move(NB);
+  cache.key.assign(fixed, fixed + n);
+  cache.key.insert(cache.key.end(), pstar, pstar + n);
+}
+
+bool cached(int n, const int *pstar, const int *fixed) {
+  if ((int)cache.key.size() != 2 * n) return false;
+  return std::equal(fixed, fixed + n, cache.key.begin()) && std::equal(pstar, pstar + n, cache.key.begin() + n);
+}
+
+}  // namespace
+
+void ls_node(const LSInst &I, const int *pstar, const int *fixed, double s, const LSParams &P,
+	     bool gate_only, LSTable &T, unsigned seed) {
+  T = LSTable();
+  const double t0 = cpu_now();
+  node_states(I, pstar, fixed, P, T, seed);
+  T.cpu_gate = cpu_now() - t0;
+  if (!gate_only) ls_table(I, pstar, fixed, s, P, T, seed);
+}
+
+void ls_table(const LSInst &I, const int *pstar, const int *fixed, double s, const LSParams &P,
+	      LSTable &T, unsigned seed) {
+  const int n = I.n, m = T.m;
+  const double eps = eps_of(I);
+  double t0 = cpu_now();
+  if (!cached(n, pstar, fixed)) node_states(I, pstar, fixed, P, T, seed);
+  const St &S0 = cache.S0, &NB = cache.NB;
+  std::vector<int> pos0(n), posB(n);
+  for (int i = 0; i < n; i++) { pos0[S0.p[i]] = i; posB[NB.p[i]] = i; }
+  T.ex.assign((size_t)m * m, 0.0);
+  std::vector<int> bestp((size_t)m * m * n);
+  St C1, C2, W;
+  // the harvest and the random searches (kicks3 > 0); rows the node fixes have rowloc -1
+  std::vector<int> rowloc(n, -1), colloc(n, -1);
+  for (int a = 0; a < m; a++) { rowloc[T.frow[a]] = a; colloc[T.fcol[a]] = a; }
+  Harvest HVs;
+  Harvest *HV = nullptr;
+  if (P.kicks3 > 0) {
+    HVs.H.assign((size_t)m * m, INFINITY);
+    HVs.rowloc = rowloc.data(); HVs.colloc = colloc.data(); HVs.m = m;
+    HV = &HVs;
+  }
+
+  for (int a = 0; a < m; a++) {
+    const int r = T.frow[a];
+    for (int bb = 0; bb < m; bb++) {
+      const int v = T.fcol[bb];
+      C1 = NB;
+      if (posB[v] != r) swap(I, C1, r, posB[v]);
+      unfree(C1, r);
+      T.moves += descent(I, C1, eps);
+      C2 = S0;
+      if (pos0[v] != r) swap(I, C2, r, pos0[v]);
+      unfree(C2, r);
+      T.moves += descent(I, C2, eps);
+      St &C = C2.cost < C1.cost - eps ? C2 : C1;
+      Rng R((uint64_t)seed * 1000003u + (uint64_t)r * n + v + 1);
+      if (HV) { HV->credit(C1); HV->credit(C2); }
+      T.moves += ils(I, C, P.kicks, P.ksize, eps, R, W, HV);
+      T.ex[(size_t)a * m + bb] = C.cost - T.z;
+      std::copy(C.p.begin(), C.p.end(), bestp.begin() + ((size_t)a * m + bb) * n);
+      if (HV) {
+	// a random completion of the node's fixes with r:v forced, descent, kicks3 kicks
+	const double tr = cpu_now();
+	St Q;
+	Q.p.assign(n, -1);
+	std::vector<int> cols;
+	for (int i = 0; i < n; i++) if (fixed[i] >= 0) Q.p[i] = fixed[i];
+	Q.p[r] = v;
+	for (int c2 : T.fcol) if (c2 != v) cols.push_back(c2);
+	Rng RR((uint64_t)seed * 2654435761u + (uint64_t)r * n + v + 31);
+	for (int k = (int)cols.size() - 1; k > 0; k--) std::swap(cols[k], cols[RR.below(k + 1)]);
+	size_t t = 0;
+	for (int r2 : T.frow) if (r2 != r) { Q.p[r2] = cols[t++]; Q.f.push_back(r2); }
+	init(I, Q);
+	T.moves += descent(I, Q, eps);
+	T.moves += ils(I, Q, P.kicks3, P.ksize, eps, RR, W, HV);
+	double &e = T.ex[(size_t)a * m + bb];
+	if (Q.cost - T.z < e) {
+	  e = Q.cost - T.z;
+	  std::copy(Q.p.begin(), Q.p.end(), bestp.begin() + ((size_t)a * m + bb) * n);
+	}
+	T.cpu_random += cpu_now() - tr;
+      }
+    }
+  }
+  if (HV)
+    for (size_t k = 0; k < (size_t)m * m; k++)
+      if (HV->H[k] - T.z < T.ex[k] - eps) { T.ex[k] = HV->H[k] - T.z; T.harvested++; }
+  T.ex_base = T.ex;
+  T.cpu_table = cpu_now() - t0;
+  t0 = cpu_now();
+  if (P.kicks2 > 0 && s > 0) {
+    for (int a = 0; a < m; a++)
+      for (int bb = 0; bb < m; bb++) {
+	double &e = T.ex[(size_t)a * m + bb];
+	if (!(e > s && e <= P.xhi * s)) continue;
+	St C;
+	C.p.assign(bestp.begin() + ((size_t)a * m + bb) * n, bestp.begin() + ((size_t)a * m + bb + 1) * n);
+	for (int r : S0.f) if (r != T.frow[a]) C.f.push_back(r);
+	init(I, C);
+	Rng R((uint64_t)seed * 7919u + (uint64_t)T.frow[a] * n + T.fcol[bb] + 977);
+	T.moves += ils(I, C, P.kicks2, P.ksize, eps, R, W, HV);
+	e = std::min(e, C.cost - T.z);
+	T.refined++;
+      }
+    if (HV)
+      for (size_t k = 0; k < (size_t)m * m; k++) T.ex[k] = std::min(T.ex[k], HV->H[k] - T.z);
+  }
+  T.cpu_refine = cpu_now() - t0;
+}
+
+void ls_line_score(const LSTable &T, bool row, int k, double s, double chain_eps, int &cnt, double &off) {
+  cnt = 0; off = 0;
+  const int m = T.m;
+  for (int t = 0; t < m; t++) {
+    const double e = row ? T.ex[(size_t)k * m + t] : T.ex[(size_t)t * m + k];
+    if (e <= s) cnt++;
+    if (e > chain_eps && s > 0) {
+      const double x = e / s;
+      const double P = 1.0 / (1.0 + std::exp(-(0.18 - 4.36 * std::log(x))));
+      off += P * std::pow(std::max(x, 0.05), -1.07);
+    }
+  }
+}
