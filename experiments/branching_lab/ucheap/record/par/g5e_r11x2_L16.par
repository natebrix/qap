0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
4    number of branching rules

0.20 use this rule when gap is worse than...
2    use this rule thru this depth.
 11   branching rule at top of tree: rule 9's lines, the size score
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
4    use this rule thru this depth.
 11   branching rule at top of tree: rule 9's lines, the size score
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 12   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 3    compute B for best _ rows of U

0.0 use this rule when gap is worse than... (all nodes thru depth 6 use rule 8)
6    use this rule thru this depth.
 11   branching rule at top of tree: rule 9's lines, the size score
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 2    branching rule at bottom of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U
[settings]
# base: the nug30 record recipe (RUNNING.md; nug_deep_xbar9_all.par, -x 1:7:1:200:1, the Nov 8 defaults written out, ship.bits = 32)
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.cheb = 3
dnn.tight_lam = 2
dnn.beta = 0.21
dnn.refresh = 120
dnn.warm_y = 2
dnn.ext = 20
dnn.gu_zone = 0
ship.bits = 32
dnn.cross = 2
dnn.lazycert = 1
dnn.beta_sched = w=0.36,wc=1.44
dnn.depths = 1:7
dnn.maxgap = 1
dnn.giveup = 200
dnn.warm = 1
# cut arm z030: base plus today's grid cut phase (nug30.dat's second matrix is the 5 x 6 grid, checked)
pool.on = 1
cut.grid = 5:6
cut.side = 1
cut.cp = 100:1000
cut.warmy = 1
cut.rounds = 12
cut.iters = 200
cut.freeze = 1000
cut.zone = 0.03
# arm g1: z030 plus an early stop: from iteration 100 a phase still more than 5 short stops (and hands its pool on), from 300 more than 2
cut.giveup = 100:5,300:2
# arm g2: g1 with the give-up rule from depth 2 on (cut.giveup_depth, added for this study): depth-1 phases run to the stall rule
cut.giveup_depth = 2
# arm g5: g2 with dnn.gu_zone = 0 (near misses go to the phase at the give-up, not 100 iterations later)
# arm g5w144: g5 with the phase's penalty factor wc = 1.44 (the coordinator's cpfast finding on tho40)
# arm g5e: g5w144 with early entry: a warm-started node may give up from iteration 100
dnn.giveup_warm = 100
branch.la_exp = 16
branch.xbar_lines = 2
