+// experiments/branching_lab/ucheap (an experiment build): the lookahead rules (4, 7, 9) choose by the size
+// score on the children's QPB bounds. branch.la_exp = L > 0: a line's score is the sum over its children of
+// exp(L (s - s_max) / G), s the child's shortfall (cutoff less its QPB bound, 0 when QPB drops it), G the
+// node's own QPB gap; the least wins, ties to rule 4's own score. branch.la_all = 1: every free line is a
+// candidate (every row where symmetry is left).
+static double la_exp() { static const double v = setting_d("branch.la_exp"); return v; }
+static int la_all() { static const int v = (int)setting_i("branch.la_all"); return v; }
+struct LaCell { int di, dj; double s; };
+static void la_size_scores(const std::vector<LaCell> &cells, double gap, int m, std::vector<double> &row, std::vector<double> &col)
+{
+  double smax = 0.0;
+  for (const LaCell &c : cells) smax = std::max(smax, c.s);
+  const double G = std::max(gap, 1e-9), L = la_exp();
+  row.assign(m, 0.0);  col.assign(m, 0.0);
+  for (const LaCell &c : cells) {
+    if (c.s <= 0.0) continue;
+    const double v = exp(L * (c.s - smax) / G);
+    row[c.di] += v;  col[c.dj] += v;
+  }
+}
 
