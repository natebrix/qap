0    has the location of a symmetry file been provided?
-1    restriction on tree depth (-1 means none)
4    number of branching rules

0.20 use this rule when gap is worse than...
2    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 30    compute B for best _ rows of U

0.12 use this rule when gap is worse than...
4    use this rule thru this depth.
 9    branching rule at top of tree
 150  Frank-Wolfe iterations, for bound 
 100  Frank-wolfe iterations, when we know we can't fathom
 12   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 3    compute B for best _ rows of U

0.0 use this rule when gap is worse than... (all nodes thru depth 6 use rule 8)
6    use this rule thru this depth.
 9    branching rule at top of tree
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

 9    branching rule at bottom of tree (rule 9 for 2: rule9_bottom)
 100   Frank-Wolfe iterations, for bound 
 50   Frank-wolfe iterations, when we know we can't fathom
 25   Frank-Wolfe iterations, for row selection
 1    which bound?
 30   step for parametric bound
 5    compute B for best _ rows of U

[settings]
# bound_lab/tai60b: experiments/estimates/tai50b/tai50b.par's values, then the cut block of regions/size50
dnn.gamma1 = 1.0
dnn.gamma = 1.0
dnn.cheb = 3
dnn.tight_lam = 2
dnn.beta = 0.21
dnn.refresh = 120
dnn.warm_y = 2
dnn.ext = 20
dnn.gu_zone = 0
ship.bits = 32
dnn.cross = 2
dnn.lazycert = 1
dnn.beta_sched = w=0.36,wc=2.88
dnn.depths = 0:58
dnn.maxgap = 1
dnn.giveup = 100
dnn.giveup_warm = 100
dnn.warm = 1
est.xbar = 1
est.xbar_mix = 0.3
# the cut phase on the cluster regions at every DNN miss, CP form, pools inherited
# --- tai60b's run (Nov 16): bound_lab/tai60b/par/rootL.par, the root the bound lab certified at
# 605,315,696 (81% of the published gap: 470 + 3,000 iterations, the stall rule off), with the children of
# its estimate (par/kidW.par: phases of at most 1,000 iterations) in the same file: below the root a phase
# stops at 1,000 (cut.giveup = 1000:0, cut.giveup_depth = 1). kidW also had the stall rule (cut.stall = 3),
# which one file cannot give the children without the root, so phases that stall run to 1,000 here: a
# little more than the estimate's 279 cloud-box core-hours (tai35b without the stall rule: a quarter more
# CPU, bound_lab/laptop/README.md). The regions beside this file (tai60b.regions: bound_lab/tai60b/regions/
# tai60b.comb6.txt, 86 regions), parents' DNN states in fp32, the pooled-solve retry on (dnn.retry = 1).
pool.on = 1
cut.regions = /home/user/wt-linetest/infra/phase1/recipes/tai60b.regions
cut.side = 0
cut.zone = 1
cut.warmy = 1
cut.rounds = 12
cut.iters = 200
cut.freeze = 0
cut.cp = 100:1000
cut.cp_iters = 8000
cut.stall = 0
cut.giveup = 1000:0
cut.giveup_depth = 8
dnn.retry = 1
