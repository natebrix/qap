+
+// EXPERIMENT: child bound from the parent's QP restricted to the face x_{di,dj} = 1.
+// A,B,C: the child's reduced problem; S,T,eig: the parent's (m x m); X1: start (m-1).
+double qpbnd_face(MAT *A,MAT *B,MAT *C,MAT *X1,MAT *U1,MAT *S,MAT *T,double eig,
+		  int di,int dj,QPBParameters *qpbp,int maxier)
+{
+  const int m1 = A->m;
+  MAT *S1 = m_get(m1,m1), *T1 = m_get(m1,m1), *G = m_get(m1,m1);
+  for (int i=0,r=0;i<m1+1;i++) { if (i==di) continue;
+    for (int j=0,c=0;j<m1+1;j++) { if (j==di) continue; S1->me[r][c++] = S->me[i][j]; } r++; }
+  for (int i=0,r=0;i<m1+1;i++) { if (i==dj) continue;
+    for (int j=0,c=0;j<m1+1;j++) { if (j==dj) continue; T1->me[r][c++] = T->me[i][j]; } r++; }
+  const double offset = qpbp->shift + eig - S->me[di][di] - T->me[dj][dj];
+  double C_X, G_X, up = 1.0e99, lo = INIT_LOBND;
+  gradient(A,B,C,S1,T1,G,X1,m1);
+  C_X = mm_trace(C,X1);  G_X = mm_trace(G,X1);
+  int *xstar = new int[m1];
+  int iter, status, bnd_used;
+  bool feasible = true;
+  fw(A,B,C,S1,T1,G,X1,U1,xstar,C_X,G_X,m1,iter,0,maxier,1000,offset,qpbp->inc,
+     feasible,status,up,lo,1.0,true,false,bnd_used,true);
+  qpbp->fw_iter += iter;
+  delete [] xstar;
+  M_FREE(S1); M_FREE(T1); M_FREE(G);
+  return lo;
+}
