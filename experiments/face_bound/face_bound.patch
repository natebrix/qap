+// ---- EXPERIMENT: face-restricted child bounds for lookahead (QAP_FACE=1 use, 2 compare)
+#include <ctime>
+#include <cstdlib>
+#include <cstdio>
+static int face_mode = getenv("QAP_FACE") ? atoi(getenv("QAP_FACE")) : 0;
+static int face_it = getenv("QAP_FACE_IT") ? atoi(getenv("QAP_FACE_IT")) : 0;
+static double face_dsum = 0, t_fresh = 0, t_face = 0;
+static long face_n = 0, f_fresh = 0, f_face = 0, f_both = 0, face_cnt = 0, face_better = 0;
+static void face_report() {
+  if (!face_mode) return;
+  fprintf(stderr, "face: %ld children; fathom fresh %ld face %ld both %ld; mean(face-fresh) over %ld unfathomed %.3f, face better %ld; cpu fresh %.2f face %.2f\n",
+	  face_cnt, f_fresh, f_face, f_both, face_n, face_n ? face_dsum/face_n : 0.0, face_better,
+	  t_fresh/CLOCKS_PER_SEC, t_face/CLOCKS_PER_SEC);
+}
+static double child_bound(QAP *qr, MAT *Bc, MAT *X1, MAT *U1, VEC *wa, VEC *wb, MAT *Wa, MAT *Wb,
+			  QPBParameters *qpbp, int di, int dj, int m)
+{
+  static bool reg = false; if (!reg) { atexit(face_report); reg = true; }
+  const bool ok = face_mode && qpb_S_last && (int)qpb_S_last->m == m;
+  const int it = face_it > 0 ? face_it : qpbp->maxier;
+  if (ok && face_mode == 1) {
+    clock_t c0 = clock();
+    double f = qpbnd_face(qr->A,Bc,qr->C,X1,U1,qpb_S_last,qpb_T_last,qpb_eig_last,di,dj,qpbp,it);
+    t_face += clock() - c0;  face_cnt++;
+    return f;
+  }
+  MAT *X0 = ok ? m_copy(X1, MNULL) : MNULL;
+  clock_t c0 = clock();
+  double b = qpbnd2(qr->A,Bc,qr->C,X1,U1,wa,wb,Wa,Wb,qpbp);
+  t_fresh += clock() - c0;
+  if (ok) {
+    MAT *U2 = m_get(U1->m, U1->n);
+    c0 = clock();
+    double f = qpbnd_face(qr->A,Bc,qr->C,X0,U2,qpb_S_last,qpb_T_last,qpb_eig_last,di,dj,qpbp,it);
+    t_face += clock() - c0;  face_cnt++;
+    const double cut = qpbp->inc - DELTA_BRANCH;
+    bool fb = b >= cut, ff = f >= cut;
+    f_fresh += fb; f_face += ff; f_both += (fb && ff);
+    if (!fb && !ff) { face_n++; face_dsum += f - b; face_better += (f > b); }
+    M_FREE(U2); M_FREE(X0);
+  }
+  return b;
+}
